{
  "appId": "com.2fac.app",
  "productName": "2FAC",
  "artifactName": "${name}-${version}-${os}-${arch}.${ext}",
  "files": [
    "dist/**/*",
    "public/icon.png",
    "package.json"
  ],
  "directories": {
    "buildResources": "public",
    "output": "release"
  },
  "protocols": [
    {
      "name": "otpauth",
      "schemes": [
        "otpauth"
      ]
    }
  ],
  "win": {
    "target": [
      "nsis",
      "portable"
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "artifactName": "${name}-${version}-${os}-${arch}-setup.${ext}"
  },
  "portable": {
    "artifactName": "${name}-${version}-${os}-${arch}-portable.${ext}"
  },
  "mac": {
    "target": [
      "dmg",
      "zip"
    ],
    "category": "public.app-category.utilities"
  },
  "linux": {
    "target": [
      "AppImage",
      "deb"
    ],
    "category": "Utility",
    "maintainer": "2FAC <noreply@example.com>"
  },
  "npmRebuild": false,
  "asarUnpack": [
    "**/node_modules/argon2/**/*.node"
  ],
  "publish": [
    {
      "provider": "github",
      "owner": "juninmd",
      "repo": "2fac"
    }
  ]
}
