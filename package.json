{
  "name": "2fac",
  "version": "1.0.0",
  "description": "A desktop app for managing two-factor authentication codes with export/import functionality",
  "main": "dist/main/main.js",
  "type": "module",
  "homepage": "./",
  "author": "2FAC",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:renderer\"",
    "dev:main": "node scripts/build-main.mjs --watch",
    "dev:renderer": "webpack serve --config webpack.config.ts --mode development",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc --noEmit && node scripts/build-main.mjs",
    "build:renderer": "webpack --config webpack.config.ts --mode production",
    "start": "electron .",
    "test": "jest",
    "electron:dev": "concurrently \"npm run build:main\" \"npm run dev:renderer\" \"wait-on http://localhost:3000 && electron . --serve\"",
    "electron:build": "npm run build && electron-builder --publish never",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/speakeasy": "^2.0.10",
    "buffer": "^6.0.3",
    "concurrently": "^10.0.5",
    "crypto-browserify": "^3.12.1",
    "css-loader": "^7.1.5",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "html-webpack-plugin": "^5.6.8",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "playwright": "^1.63.0",
    "process": "^0.11.10",
    "stream-browserify": "^3.0.0",
    "style-loader": "^4.0.0",
    "ts-jest": "^29.4.14",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "url": "^0.11.4",
    "util": "^0.12.5",
    "vm-browserify": "^1.1.2",
    "wait-on": "^9.5.1",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "argon2": "^0.45.1",
    "crypto-js": "^4.2.0",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "jsqr": "^1.4.0",
    "otpauth": "^9.5.2",
    "protobufjs": "^8.8.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "speakeasy": "^2.0.0"
  },
  "packageManager": "pnpm@10.28.2+sha512.41872f037ad22f7348e3b1debbaf7e867cfd448f2726d9cf74c08f19507c31d2c8e7a11525b983febc2df640b5438dee6023ebb1f84ed43cc2d654d2bc326264",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
