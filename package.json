{
  "name": "2fac",
  "version": "1.0.0",
  "description": "A desktop app for managing two-factor authentication codes with export/import functionality",
  "main": "dist/main/main.js",
  "homepage": "./",
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:renderer\"",
    "dev:main": "tsc --watch --project tsconfig.json",
    "dev:renderer": "webpack serve --config webpack.config.js --mode development",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc --project tsconfig.json",
    "build:renderer": "webpack --config webpack.config.js --mode production",
    "start": "electron .",
    "electron:dev": "concurrently \"npm run build:main\" \"npm run dev:renderer\" \"wait-on http://localhost:3000 && electron . --serve\"",
    "electron:build": "npm run build && electron-builder"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.10.6",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@types/speakeasy": "^2.0.10",
    "@types/testing-library__jest-dom": "^5.14.9",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "buffer": "^6.0.3",
    "concurrently": "^8.2.2",
    "crypto-browserify": "^3.12.1",
    "css-loader": "^7.1.2",
    "electron": "^27.3.11",
    "electron-builder": "^24.6.4",
    "eslint": "^8.56.0",
    "html-webpack-plugin": "^5.6.6",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "playwright": "^1.57.0",
    "process": "^0.11.10",
    "stream-browserify": "^3.0.0",
    "style-loader": "^4.0.0",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "url": "^0.11.4",
    "util": "^0.12.5",
    "vm-browserify": "^1.1.2",
    "wait-on": "^7.2.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.2"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "crypto-js": "^4.2.0",
    "electron-store": "^8.1.0",
    "jsqr": "^1.4.0",
    "otpauth": "^9.4.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "speakeasy": "^2.0.0"
  }
}
